  "tasks": {
    "task-001": {
      "id": "task-001",
      "projectId": "proj-gw-2026-001",
      "phaseId": "phase-001-a",
      "name": "Conduct Site Walkthrough & Photo Documentation",
      "description": "Perform comprehensive site reconnaissance including visual inspection of all accessible areas, identification of potential source areas, documentation of current site conditions, and photographic survey of key features.",
      "status": "done",
      "priority": "high",
      "assignedTo": ["pers-002", "pers-004"],
      "startDate": "2026-02-01",
      "dueDate": "2026-02-07",
      "dependsOn": [],
      "order": 0,
      "createdAt": "2026-01-15T10:30:00.000Z",
      "updatedAt": "2026-02-08T14:20:00.000Z"
    },
    "task-002": {
      "id": "task-002",
      "projectId": "proj-gw-2026-001",
      "phaseId": "phase-001-a",
      "name": "Interview Site Personnel & Compile Facility History",
      "description": "Conduct interviews with current property manager and available former employees. Document historical operations, chemical usage, waste disposal practices, and any known spills or releases.",
      "status": "done",
      "priority": "high",
      "assignedTo": ["pers-006", "pers-007"],
      "startDate": "2026-02-05",
      "dueDate": "2026-02-15",
      "dependsOn": ["task-001"],
      "order": 1,
      "createdAt": "2026-01-15T10:31:00.000Z",
      "updatedAt": "2026-02-16T09:15:00.000Z"
    },
    "task-003": {
      "id": "task-003",
      "projectId": "proj-gw-2026-001",
      "phaseId": "phase-001-b",
      "name": "Review Historical Records & Regulatory Database Search",
      "description": "Compile and review historical aerial photographs, fire insurance maps, manufacturing records, and prior environmental reports. Search federal and state databases (NPL, CERCLIS, RCRA, UST) for site and surrounding properties.",
      "status": "done",
      "priority": "high",
      "assignedTo": ["pers-007", "pers-003"],
      "startDate": "2026-02-10",
      "dueDate": "2026-02-28",
      "dependsOn": ["task-001"],
      "order": 0,
      "createdAt": "2026-01-15T10:32:00.000Z",
      "updatedAt": "2026-03-01T11:30:00.000Z"
    },
    "task-004": {
      "id": "task-004",
      "projectId": "proj-gw-2026-001",
      "phaseId": "phase-001-b",
      "name": "Develop Conceptual Site Model & Sampling Plan",
      "description": "Synthesize all Phase 1 findings into a conceptual site model identifying potential contaminant sources, migration pathways, and receptors. Prepare detailed sampling and analysis plan for regulatory approval.",
      "status": "in-progress",
      "priority": "critical",
      "assignedTo": ["pers-001", "pers-002"],
      "startDate": "2026-03-01",
      "dueDate": "2026-03-15",
      "dependsOn": ["task-002", "task-003"],
      "order": 1,
      "createdAt": "2026-01-15T10:33:00.000Z",
      "updatedAt": "2026-03-05T16:45:00.000Z"
    },
    "task-005": {
      "id": "task-005",
      "projectId": "proj-gw-2026-001",
      "phaseId": "phase-002-a",
      "name": "Obtain Well Drilling Permits & Utility Clearance",
      "description": "Submit well installation permit applications to state environmental agency. Coordinate with utility locating services (811) for clearance. Prepare health and safety plan for drilling operations.",
      "status": "todo",
      "priority": "high",
      "assignedTo": ["pers-006", "pers-002"],
      "startDate": "2026-03-16",
      "dueDate": "2026-03-22",
      "dependsOn": ["task-004"],
      "order": 0,
      "createdAt": "2026-01-15T10:34:00.000Z",
      "updatedAt": "2026-01-15T10:34:00.000Z"
    },
    "task-006": {
      "id": "task-006",
      "projectId": "proj-gw-2026-001",
      "phaseId": "phase-002-a",
      "name": "Install 8 Monitoring Wells (MW-1 through MW-8)",
      "description": "Drill and install 8 groundwater monitoring wells using hollow-stem auger method. Wells to include 3 upgradient, 4 downgradient, and 1 deep aquifer well. Depths ranging from 25-65 feet. Install 2-inch PVC wells with 10-foot screens, bentonite seals, and flush-mount protective covers.",
      "status": "todo",
      "priority": "critical",
      "assignedTo": ["pers-002", "pers-004"],
      "startDate": "2026-03-25",
      "dueDate": "2026-04-10",
      "dependsOn": ["task-005"],
      "order": 1,
      "createdAt": "2026-01-15T10:35:00.000Z",
      "updatedAt": "2026-01-15T10:35:00.000Z"
    },
    "task-007": {
      "id": "task-007",
      "projectId": "proj-gw-2026-001",
      "phaseId": "phase-002-a",
      "name": "Well Development & Aquifer Testing",
      "description": "Develop all monitoring wells to remove drilling fluids and fines. Conduct slug tests on each well to determine hydraulic conductivity. Collect lithologic samples for lab testing. Survey well locations with GPS and measure top-of-casing elevations.",
      "status": "todo",
      "priority": "high",
      "assignedTo": ["pers-004", "pers-007"],
      "startDate": "2026-04-08",
      "dueDate": "2026-04-15",
      "dependsOn": ["task-006"],
      "order": 2,
      "createdAt": "2026-01-15T10:36:00.000Z",
      "updatedAt": "2026-01-15T10:36:00.000Z"
    },
    "task-008": {
      "id": "task-008",
      "projectId": "proj-gw-2026-001",
      "phaseId": "phase-002-b",
      "name": "Baseline Groundwater Sampling Event",
      "description": "Conduct first round of groundwater sampling from all 8 monitoring wells. Measure water levels, field parameters (pH, temperature, conductivity, DO, ORP). Collect samples for PFAS (EPA Method 537.1), VOCs (EPA Method 8260), metals (EPA Method 6020), and general chemistry.",
      "status": "todo",
      "priority": "critical",
      "assignedTo": ["pers-004", "pers-007"],
      "startDate": "2026-04-20",
      "dueDate": "2026-04-25",
      "dependsOn": ["task-007"],
      "order": 0,
      "createdAt": "2026-01-15T10:37:00.000Z",
      "updatedAt": "2026-01-15T10:37:00.000Z"
    },
    "task-009": {
      "id": "task-009",
      "projectId": "proj-gw-2026-001",
      "phaseId": "phase-002-b",
      "name": "Confirmation Sampling Event (Round 2)",
      "description": "Conduct second round of groundwater sampling 3 weeks after baseline event to confirm contaminant presence and assess temporal variability. Focus on wells showing exceedances in Round 1.",
      "status": "todo",
      "priority": "high",
      "assignedTo": ["pers-004", "pers-007"],
      "startDate": "2026-05-10",
      "dueDate": "2026-05-15",
      "dependsOn": ["task-008"],
      "order": 1,
      "createdAt": "2026-01-15T10:38:00.000Z",
      "updatedAt": "2026-01-15T10:38:00.000Z"
    },
    "task-010": {
      "id": "task-010",
      "projectId": "proj-gw-2026-001",
      "phaseId": "phase-003-a",
      "name": "Laboratory Analysis & QA/QC Review",
      "description": "Oversee laboratory analysis of all groundwater samples. Review laboratory QA/QC documentation including method blanks, field duplicates, matrix spikes, and surrogate recoveries. Validate all analytical results per EPA guidelines.",
      "status": "todo",
      "priority": "high",
      "assignedTo": ["pers-005"],
      "startDate": "2026-04-25",
      "dueDate": "2026-05-30",
      "dependsOn": ["task-008"],
      "order": 0,
      "createdAt": "2026-01-15T10:39:00.000Z",
      "updatedAt": "2026-01-15T10:39:00.000Z"
    },
    "task-011": {
      "id": "task-011",
      "projectId": "proj-gw-2026-001",
      "phaseId": "phase-003-b",
      "name": "Groundwater Flow & Contaminant Plume Mapping",
      "description": "Analyze water level data to determine groundwater flow direction and hydraulic gradient. Create potentiometric surface maps. Delineate contaminant plumes for PFAS and VOCs using GIS. Generate cross-sections showing vertical extent of contamination.",
      "status": "todo",
      "priority": "high",
      "assignedTo": ["pers-003", "pers-001"],
      "startDate": "2026-05-25",
      "dueDate": "2026-06-10",
      "dependsOn": ["task-010"],
      "order": 0,
      "createdAt": "2026-01-15T10:40:00.000Z",
      "updatedAt": "2026-01-15T10:40:00.000Z"
    },
    "task-012": {
      "id": "task-012",
      "projectId": "proj-gw-2026-001",
      "phaseId": "phase-003-b",
      "name": "Human Health & Ecological Risk Assessment",
      "description": "Conduct Tier 2 quantitative risk assessment using EPA risk assessment guidance. Evaluate exposure pathways including groundwater ingestion, vapor intrusion, and surface water discharge. Calculate risk-based screening levels and compare to analytical results.",
      "status": "todo",
      "priority": "critical",
      "assignedTo": ["pers-001", "pers-005"],
      "startDate": "2026-06-05",
      "dueDate": "2026-06-20",
      "dependsOn": ["task-011"],
      "order": 1,
      "createdAt": "2026-01-15T10:41:00.000Z",
      "updatedAt": "2026-01-15T10:41:00.000Z"
    },
    "task-013": {
      "id": "task-013",
      "projectId": "proj-gw-2026-001",
      "phaseId": "phase-004-a",
      "name": "Evaluate Remediation Technologies & Cost Estimates",
      "description": "Assess feasibility of remediation alternatives including monitored natural attenuation, in-situ chemical oxidation, pump-and-treat, and permeable reactive barriers. Prepare cost estimates for 30-year lifecycle including capital costs, O&M, and monitoring.",
      "status": "todo",
      "priority": "high",
      "assignedTo": ["pers-001", "pers-002"],
      "startDate": "2026-06-15",
      "dueDate": "2026-07-10",
      "dependsOn": ["task-012"],
      "order": 0,
      "createdAt": "2026-01-15T10:42:00.000Z",
      "updatedAt": "2026-01-15T10:42:00.000Z"
    },
    "task-014": {
      "id": "task-014",
      "projectId": "proj-gw-2026-001",
      "phaseId": "phase-004-a",
      "name": "Prepare Final Investigation Report",
      "description": "Compile comprehensive site investigation report including executive summary, site history, field methods, analytical results, risk assessment, and remedial alternatives analysis. Prepare for submittal to state environmental agency and client stakeholders.",
      "status": "todo",
      "priority": "critical",
      "assignedTo": ["pers-001", "pers-002", "pers-006"],
